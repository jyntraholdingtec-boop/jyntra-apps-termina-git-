{
  "name": "jyntra-fuentes",
  "private": true,
  "description": "Recompila las piezas precompiladas de public/vendor. Uso: npm install  y luego  npm run compilar",
  "scripts": {
    "compilar": "npm run perfil && npm run cine",
    "perfil": "esbuild perfil-atleta.jsx --bundle --format=iife --minify --jsx=transform --jsx-factory=React.createElement --jsx-fragment=React.Fragment --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=none --target=es2018 --outfile=../public/vendor/perfil-atleta.js",
    "cine": "tailwindcss -c tailwind-cine.config.js -i tailwind-entrada.css -o ../public/vendor/cine-tailwind.css --minify && node rojo-tailwind.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "3.4.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.383.0"
  }
}